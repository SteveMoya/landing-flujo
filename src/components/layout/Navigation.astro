---
import { site } from '../../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<nav class:list={['items-center gap-6', className]} aria-label="Navegación principal">
  {
    site.nav.map((item) => (
      <a
        href={item.href}
        class="font-body text-sm font-medium text-on-surface/70 transition-colors duration-200 hover:text-primary"
      >
        {item.label}
      </a>
    ))
  }
</nav>