---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="bg-surface border-t border-on-surface/10">
  <div class="container-flujo py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-5">
        <Logo />
        <p class="max-w-xs text-sm leading-relaxed text-on-surface-variant">
          {site.description}
        </p>
        <div class="flex gap-3">
          {
            site.socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="grid h-10 w-10 place-items-center rounded-full bg-surface-dim text-on-surface-variant transition-all duration-200 hover:-translate-y-0.5 hover:text-primary"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Explorar">
        <h3 class="mb-4 text-sm font-medium uppercase tracking-wide text-on-surface-variant">Producto</h3>
        <ul class="space-y-3">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-on-surface/70 transition-colors hover:text-primary">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <h3 class="text-sm font-medium uppercase tracking-wide text-on-surface-variant">Contacto</h3>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 text-sm text-on-surface/70 transition-colors hover:text-primary"
        >
          <Icon name="mail" size={16} class="text-on-surface-variant" />
          {site.email}
        </a>
        <p class="max-w-[220px] text-xs leading-relaxed text-on-surface-variant/80">
          Soporte humano en menos de 4 h. También en español. 🇪🇸
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-medium uppercase tracking-wide text-on-surface-variant">Estado del servicio</h3>
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full bg-surface-dim px-4 py-2.5 text-sm font-medium text-on-surface"
        >
          <span class="h-2.5 w-2.5 rounded-full bg-secondary" aria-hidden="true"></span>
          Todos los sistemas operativos
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-on-surface/10 pt-8 text-xs text-on-surface-variant sm:flex-row">
      <p>© {new Date().getFullYear()} {site.name}. Hecho con flujo.</p>
      <div class="flex gap-6">
        <a href={site.legal.privacy} class="transition-colors hover:text-primary">Privacidad</a>
        <a href={site.legal.terms} class="transition-colors hover:text-primary">Términos</a>
        <a href="#" class="transition-colors hover:text-primary">Estado</a>
      </div>
    </div>
  </div>
</footer>