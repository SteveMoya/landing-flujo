---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Avatar from '../ui/Avatar.astro';
import Icon from '../ui/Icon.astro';
---

<section class="relative overflow-hidden pt-28 md:pt-36">
  <!-- manchas de color tipo Material tonal -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-24 -top-24 h-[420px] w-[420px] rounded-full bg-primary-container/60 blur-[90px]"></div>
    <div class="absolute right-[-100px] top-1/3 h-[380px] w-[380px] rounded-full bg-secondary-container/50 blur-[90px]"></div>
  </div>

  <div class="container-flujo relative grid items-center gap-16 pb-24 lg:grid-cols-2 lg:pb-32">
    <div data-reveal>
      <Chip class="mb-6" color="tertiary">🪄 {site.hero.badge}</Chip>
      <h1 class="font-body text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
        {site.hero.title.start}
        <span class="text-primary">{site.hero.title.accent}</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-on-surface-variant">{site.hero.subtitle}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <Button href="#cta" size="lg">
          {site.hero.primaryCta}
          <Icon name="arrow-right" size={18} />
        </Button>
        <Button href="#como" variant="tonal" size="lg">
          {site.hero.secondaryCta}
        </Button>
      </div>

      <dl data-reveal style="--reveal-delay:150ms" class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {
          site.stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-body text-2xl font-bold tracking-tight text-on-surface">{s.value}</dd>
              <dd class="text-xs text-on-surface-variant">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Mockup de la app (Material) -->
    <div data-reveal style="--reveal-delay:120ms" class="relative mx-auto w-full max-w-md">
      <div class="surface elev-3 overflow-hidden">
        <!-- app bar -->
        <div class="flex items-center justify-between bg-primary px-5 py-4 text-on-primary">
          <div class="flex items-center gap-3">
            <span class="h-8 w-8 rounded-lg bg-white/20" aria-hidden="true"></span>
            <div>
              <p class="text-sm font-medium">Proyecto: Renovación</p>
              <p class="text-[11px] text-white/70">12 miembros · Oct 2026</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <Avatar initials="DR" color="secondary" size="sm" class="ring-2 ring-white/40" />
            <Avatar initials="JS" color="tertiary" size="sm" class="ring-2 ring-white/40" />
            <Avatar initials="+3" color="error" size="sm" class="ring-2 ring-white/40" />
          </div>
        </div>

        <!-- kanban -->
        <div class="grid grid-cols-3 gap-3 bg-surface-dim p-4">
          {['Por hacer', 'En curso', 'Listo'].map((col, ci) => (
            <div class="rounded-xl bg-surface p-2.5 shadow-elev-1">
              <p class="mb-2 px-1 text-[11px] font-medium text-on-surface-variant">{col}</p>
              <div class="space-y-2">
                {(ci === 2 ? [0] : [0, 1]).map((card) => (
                  <div class="rounded-lg border border-on-surface/10 bg-surface p-2.5 shadow-elev-1">
                    <div class="h-1.5 w-2/3 rounded bg-primary/70"></div>
                    <div class="mt-2 h-1.5 w-full rounded bg-on-surface/10"></div>
                    <div class="mt-2 flex items-center justify-between">
                      {card === 1 ? (
                        <>
                          <span class="h-4 w-4 rounded-full bg-secondary/50"></span>
                          <span class="h-2 w-2 rounded-full bg-tertiary"></span>
                        </>
                      ) : (
                        <>
                          <span class="h-4 w-4 rounded-full bg-tertiary/60"></span>
                          <span class="h-2 w-2 rounded-full bg-error/70"></span>
                        </>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- FAB -->
        <div class="pointer-events-none absolute bottom-5 right-5 grid h-14 w-14 place-items-center rounded-full bg-primary text-on-primary shadow-elev-3">
          <Icon name="plus" size={24} />
        </div>
      </div>
      <!-- chip flotante de IA -->
      <div class="absolute -left-3 top-1/4 -translate-y-1/2 rounded-full bg-surface px-4 py-2 text-xs font-medium text-on-surface shadow-elev-2 sm:-left-6">
        ✨ 3 tareas sugeridas con IA
      </div>
    </div>
  </div>
</section>