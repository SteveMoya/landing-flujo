---
import { plans } from '../../data/plans';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="precios" ariaLabelledBy="pricing-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 text-sm font-medium uppercase tracking-wide text-primary">Precios</p>
    <h2 id="pricing-title" class="font-body text-4xl font-bold tracking-tight text-on-surface sm:text-5xl">
      Planes simples, <span class="text-primary">sin sorpresas</span>
    </h2>
  </div>

  <ul class="grid gap-6 md:grid-cols-3">
    {
      plans.map((p, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <Card
            elevation={p.featured ? 3 : 1}
            class:list={['relative flex h-full flex-col', p.featured && 'border-2 border-primary']}
          >
            {p.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1 text-[11px] font-medium uppercase tracking-wide text-on-primary shadow-elev-2">
                Más popular
              </span>
            )}
            <h3 class="text-lg font-semibold tracking-tight text-on-surface">{p.name}</h3>
            <p class="mt-3">
              <span class="font-body text-4xl font-bold tracking-tight text-on-surface">{p.price}</span>
              <span class="text-sm text-on-surface-variant"> / {p.period}</span>
            </p>
            <p class="mt-2 text-sm text-on-surface-variant">{p.description}</p>
            <ul class="mt-6 flex-1 space-y-3">
              {
                p.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-on-surface">
                    <Icon name="check" size={16} class="mt-0.5 shrink-0 text-secondary" />
                    {f}
                  </li>
                ))
              }
            </ul>
            <Button href="#cta" variant={p.featured ? 'filled' : 'tonal'} class="mt-8 w-full">
              {p.cta}
            </Button>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>