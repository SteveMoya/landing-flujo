---
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="cta" ariaLabelledBy="cta-title">
  <div class="surface elev-3 relative overflow-hidden px-6 py-16 text-center sm:px-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-primary-container/70 blur-[70px]"></div>
      <div class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-secondary-container/60 blur-[80px]"></div>
    </div>

    <div class="relative mx-auto max-w-xl">
      <span class="mx-auto mb-6 grid h-16 w-16 place-items-center rounded-2xl bg-primary text-on-primary shadow-elev-3">
        <Icon name="sparkles" size={28} />
      </span>
      <h2 id="cta-title" class="font-body text-4xl font-bold tracking-tight text-on-surface sm:text-5xl">
        Empieza a fluir <span class="text-primary">hoy</span>
      </h2>
      <p class="mt-4 text-lg text-on-surface-variant">
        Gratis para siempre en el plan básico. Sin tarjeta, sin llamadas de ventas, sin contratos.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-9 py-4 font-body text-base font-medium text-on-primary shadow-elev-2 transition-all duration-200 hover:bg-primary-dark hover:shadow-elev-3 active:scale-[0.98]"
        >
          Crear cuenta gratis
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#precios" class="font-body text-sm font-medium text-primary underline-offset-4 hover:underline">
          Ver precios
        </a>
      </div>

      <form data-newsletter-form class="mx-auto mt-14 max-w-md" novalidate>
        <p class="mb-3 text-sm font-medium text-on-surface">{site.newsletter.title}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <label for="newsletter-email" class="sr-only">Correo electrónico</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder={site.newsletter.placeholder}
            class="w-full rounded-full border-2 border-on-surface/15 bg-surface-dim px-5 py-3.5 text-sm text-on-surface placeholder:text-on-surface-variant focus:border-primary focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-secondary px-6 py-3.5 font-body text-sm font-medium text-on-primary shadow-elev-1 transition-all duration-200 hover:brightness-95 active:scale-[0.98]"
          >
            {site.newsletter.button}
          </button>
        </div>
        <p data-newsletter-status class="mt-3 min-h-5 text-sm font-medium" data-success={site.newsletter.success} aria-live="polite"></p>
      </form>
    </div>
  </div>
</Section>

<script>
  import { initNewsletter } from '../../scripts/newsletter';

  initNewsletter();
</script>